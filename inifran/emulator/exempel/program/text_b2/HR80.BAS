10 REM HR80, EN BILD PÅ GRAFIKKORTET I HR-80:S ANDA (UTANFÖR BOKEN)
20 REM FÖR BASIC II: PR: PÅ V24, 9600 BAUD, TECKNEN SOM DE ÄR (S)
30 DIM A$=80 : E$=CHR$(27) : P=3.14159
40 OPEN "PR:VSA70A99.7" AS FILE 1
50 PRINT CHR$(12);"Bilden går till V24 ..."
60 REM FÄRG 0 BLÅ, 1 GUL, 2 GRÖN, 3 VIT (ESC 0-3); RENSA MED BLÅTT
70 A$=E$+"0"+CHR$(4)+E$+"1"+CHR$(3)+E$+"2"+CHR$(2)+E$+"3"+CHR$(7)+CHR$(12)
80 GOSUB 500
90 REM SOLEN: EN RING AV LINJER I GULT, SOM FYLLS
100 A$=CHR$(1)+CHR$(1)+CHR$(28)+CHR$(220)+CHR$(190) : GOSUB 500
110 FOR V=1 TO 16
120 A$=CHR$(4)+CHR$(INT(200.5+20*COS(V*P/8)))+CHR$(INT(190.5+20*SIN(V*P/8)))
130 GOSUB 500 : NEXT V
140 A$=CHR$(5)+CHR$(200)+CHR$(190) : GOSUB 500
150 REM KULLARNA: EN SINUSKURVA I GRÖNT, FYLLD UNDER
160 A$=CHR$(1)+CHR$(2)+CHR$(28)+CHR$(0)+CHR$(70) : GOSUB 500
170 FOR X=5 TO 255 STEP 5
180 A$=CHR$(4)+CHR$(X)+CHR$(INT(70.5+20*SIN(X/25))) : GOSUB 500
190 NEXT X
200 A$=CHR$(5)+CHR$(128)+CHR$(2) : GOSUB 500
210 REM MAKRO 128, ETT HUS FRÅN DEN FASTA PUNKTEN (NEDRE VÄNSTRA HÖRNET):
220 REM VÄGGARNA I VITT, FYLLDA, OCH TAKET I GULT, FYLLT
230 A$=E$+"D"+CHR$(128)+"R"+CHR$(1)+CHR$(3)
240 A$=A$+CHR$(30)+CHR$(20)+CHR$(0)+CHR$(30)+CHR$(0)+CHR$(16)
250 A$=A$+CHR$(30)+CHR$(236)+CHR$(0)+CHR$(30)+CHR$(0)+CHR$(240)
260 A$=A$+CHR$(31)+CHR$(10)+CHR$(8)+CHR$(29)+CHR$(0)+CHR$(16)+CHR$(1)+CHR$(1)
270 A$=A$+CHR$(30)+CHR$(10)+CHR$(10)+CHR$(30)+CHR$(10)+CHR$(246)
280 A$=A$+CHR$(31)+CHR$(246)+CHR$(4)+CHR$(254) : GOSUB 500
290 REM FYRA HUS: FAST PUNKT OCH MAKROT
300 FOR H=1 TO 4 : A$=CHR$(28)+CHR$(H*44-20)+CHR$(14)+CHR$(128) : GOSUB 500
310 NEXT H
320 REM TEXTEN I VITT PÅ RAD 1 OCH 2 (CHR$(18), RAD+32, KOLUMN+32)
330 A$=CHR$(20)+CHR$(3)+CHR$(18)+CHR$(33)+CHR$(43)+"ABC80 RITAR PÅ V24"
340 GOSUB 500
350 A$=CHR$(18)+CHR$(34)+CHR$(38)+"GRAFIKKORTET I HR-80:S ANDA" : GOSUB 500
360 PRINT "Klart."
365 CLOSE 1
370 END
500 REM SKICKA A$ TILL V24; ; SIST, SÅ ATT INGET CR LF KOMMER
510 PRINT #1,A$;
520 RETURN
