EXTEND
1000 ! SNAKE3.BAS FOR BASIC II ON THE ABC80 (40 COLUMNS)
1002 ! THE NAMES ARE LONG, SO EXTEND MUST BE GIVEN BEFORE THE
1004 ! LINES ARE TYPED IN; THE EXTEND ON LINE 1010 IS FOR RUN.
1006 ! BASIC II-80 HAS NO SET DOT, CLR DOT OR DOT, SO FNSet,
1008 ! FNClr AND FNDot WORK ON THE SCREEN MEMORY AT 31744.
1010 EXTEND : RANDOMIZE : INTEGER
1020 ! main
1030 T=FNInit
1040 WHILE 1
1050   T=FNGkey
1060   IF Fx=X AND Fy=Y THEN T=FNGeat ELSE T=FNGtest
1070   IF T THEN 1120
1080   T=FNGmove
1090   T=FNGshift
1100   T=FNGdraw
1110 WEND
1120 ; CUR(10,10);CHR$(135) 'G A M E   O V E R' CHR$(151);
1130 ; CUR(12,14);CHR$(135) 'Score: ';Score;CHR$(151);
1140 END
1150 ! end of main
1160 !
1170 ! init of game
1180 DEF FNInit
1190   Cu1=1
1200   Fx=0 : Fy=0
1210   Mx=79 : My=71
1220   T=FNGfood
1230   Smin=5
1240   Tail=Smin
1250   Smax=500
1260   DIM R(Smax),C(Smax),Bit(5)
1262   Bit(0)=1 : Bit(1)=2 : Bit(2)=4 : Bit(3)=8 : Bit(4)=16 : Bit(5)=64
1270   R(0)=5 : R(1)=4 : R(2)=3 : R(3)=2 : R(4)=1
1280   T=Mx/2
1290   C(0)=T : C(1)=T : C(2)=T : C(3)=T : C(4)=T
1300   R1=R(Tail-1) : C1=C(Tail-1)
1310   Score=0
1320   T=FNGinit
1330   RETURN 0
1340 FNEND
1350 ! keys: a left, s right, w up, z down, held down
1360 DEF FNGkey LOCAL K,Cu
1370   K=INP(56) : IF K<128 THEN K=0 ELSE K=(K AND 127) OR 32
1380   IF 97=K AND Cu1<>3 THEN Cu=1
1390   IF 115=K AND Cu1<>1 THEN Cu=3
1400   IF 122=K AND Cu1<>4 THEN Cu=2
1410   IF 119=K AND Cu1<>2 THEN Cu=4
1420   X=R(0) : Y=C(0)
1430   IF Cu=0 THEN Cu=Cu1
1440   ON Cu GOTO 1450,1460,1470,1480
1450   Y=Y-1 : GOTO 1490
1460   X=X+1 : GOTO 1490
1470   Y=Y+1 : GOTO 1490
1480   X=X-1
1490   Cu1=Cu
1500   RETURN 0
1510 FNEND
1520 ! graphics init
1530 DEF FNGinit
1540   ; CHR$(12);
1550   FOR I=0 TO 23
1560     ; CUR(I,0);CHR$(151);
1570   NEXT I
1580   FOR I=2 TO Mx
1590     T=FNSet(0,I) : T=FNSet(My,I)
1600   NEXT I
1610   FOR I=0 TO My
1620     T=FNSet(I,2) : T=FNSet(I,Mx)
1630   NEXT I
1640   RETURN 0
1650 FNEND
1660 ! create food
1670 DEF FNGfood
1680   Fx=INT(RND*(My-10))+5
1690   Fy=INT(RND*(Mx-20))+10
1700   RETURN 0
1710 FNEND
1720 ! shift snake
1730 DEF FNGshift LOCAL Tr,Tc
1740   Tr=R(Tail-1)
1750   Tc=C(Tail-1)
1760   FOR I=Tail-1 TO 1 STEP -1
1770     R(I)=R(I-1) : C(I)=C(I-1)
1780   NEXT I
1790   R(0)=Tr : C(0)=Tc
1800 RETURN 0
1810 FNEND
1820 ! eat food
1830 DEF FNGeat
1840   R(Tail)=X
1850   C(Tail)=Y
1860   IF Tail<Smax THEN Tail=Tail+1 ELSE Tail=Smax
1870   Score=Score+1
1880   T=FNGfood
1890   RETURN 0
1900 FNEND
1910 ! move
1920 DEF FNGmove
1930   R(Tail-1)=X : C(Tail-1)=Y
1940   RETURN 0
1950 FNEND
1960 ! test DOT
1970 DEF FNGtest
1980   IF FNDot(X,Y) THEN RETURN -1
1990   RETURN 0
2000 FNEND
2010 ! draw
2020 DEF FNGdraw LOCAL T
2030   T=Tail-1
2040   T=FNClr(R1,C1)
2045   T=Tail-1
2050   FOR I=0 TO T
2060     T1=FNSet(R(I),C(I))
2070   NEXT I
2080   R1=R(T) : C1=C(T)
2090   T=FNSet(Fx,Fy)
2100   RETURN 0
2110 FNEND
2200 ! dots on the screen: row 0-71, column 2-79
2210 DEF FNAdr(R,K)=31744+((R/3) AND 7)*128+(R/24)*40+K/2
2220 DEF FNBit(R,K)=Bit((R-3*(R/3))*2+(K AND 1))
2230 DEF FNSet(R,K) LOCAL A
2240   A=FNAdr(R,K) : POKE A,PEEK(A) OR FNBit(R,K)
2250   RETURN 0
2260 FNEND
2270 DEF FNClr(R,K) LOCAL A
2280   A=FNAdr(R,K) : POKE A,PEEK(A) AND NOT FNBit(R,K)
2290   RETURN 0
2300 FNEND
2310 DEF FNDot(R,K)=(PEEK(FNAdr(R,K)) AND FNBit(R,K))<>0
2320 ! S. Lonnert, public domain 2024
