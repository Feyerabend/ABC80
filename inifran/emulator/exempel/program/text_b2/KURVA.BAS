10 REM KURVOR, ETT EXEMPEL TILL ABC80 INIFRÅN, FÖR BASIC II
20 REM BASIC II PÅ ABC80 HAR INGET SET DOT, SÅ RAD 1000 SÄTTER
25 REM PUNKTEN R%,K% SJÄLV I BILDMINNET (31744 = $7C00):
26 REM R% 0-71 UPPIFRÅN, K% 2-79; KOLUMN 0-1 ÄR RUTAN DÄR
27 REM GRAFIKKODEN CHR$(151) STÅR
30 DIM D%(2%,1%)
40 FOR Y%=0% TO 2% : FOR X%=0% TO 1% : READ D%(Y%,X%) : NEXT X% : NEXT Y%
50 DATA 1,2,4,8,16,64
60 PRINT CHR$(12);
70 FOR R%=0% TO 22% : PRINT CUR(R%,0%);CHR$(151); : NEXT R%
80 R%=34% : FOR K%=2% TO 79% : GOSUB 1000 : NEXT K%
90 K%=40% : FOR R%=0% TO 68% : GOSUB 1000 : NEXT R%
100 FOR K%=2% TO 79%
110 R%=INT(34.5-30*SIN((K%-40)/6)) : GOSUB 1000
120 R%=INT(34.5-30*COS((K%-40)/4)*EXP(-ABS(K%-40)/20)) : GOSUB 1000
130 NEXT K%
140 PRINT CUR(23%,0%);"Sinus och en dämpad cosinus. Tangent!";
150 GET A$
160 PRINT CHR$(12);
170 END
1000 REM SÄTT PUNKTEN R%,K%
1010 Y%=R%/3% : X%=K%/2%
1020 A=31744+(Y% AND 7%)*128+(Y%/8%)*40+X%
1030 POKE A,PEEK(A) OR D%(R%-3%*Y%,K%-2%*X%)
1040 RETURN
