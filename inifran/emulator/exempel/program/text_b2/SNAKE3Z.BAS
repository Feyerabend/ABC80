110 POKE P,H%,M%,V% : P=P+3 : S=S+H%+M%+V% : NEXT I%
120 GOTO 60
130 READ T : IF S=T THEN 150
140 PRINT "Fel i DATA-raderna." : END
150 Z=CALL(36864)
160 PRINT CUR(12,14);CHR$(135);"Score: ";Z;CHR$(151)
170 PRINT CUR(22,0);
