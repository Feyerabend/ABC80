60 READ A$ : IF A$="." THEN 130
70 FOR I%=1% TO LEN(A$) STEP 4%
80 A%=ASC(MID$(A$,I%,1%))-48% : B%=ASC(MID$(A$,I%+1%,1%))-48%
90 C%=ASC(MID$(A$,I%+2%,1%))-48% : D%=ASC(MID$(A$,I%+3%,1%))-48%
