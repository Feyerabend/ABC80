10 REM DKALK, RÄKNAR SJÄLVDEKLARATIONEN I DR1:DEKL.DAT (UTANFÖR BOKEN)
20 REM TALEN TAS UR SKÄRMBILDERNA: RUTA N ÄR RADEN SOM BÖRJAR MED N, OCH
30 REM BELOPPET STÅR EFTER <. DET RÄKNAS MED ASCII-SIFFROR, TIO I VARJE
40 REM TAL OCH TIOKOMPLEMENT FÖR MINUS, SÅ ATT INGA SIFFROR FÖRSVINNER
50 REM (FLYTTALEN HAR BARA SEX). REGLERNA ÄR DATA FRÅN RAD 900: RUTAN OCH
55 REM STEGEN =N +N -N, #C ÄR ETT TAL, %C GÅNGER C PROCENT, P INTE MINUS.
60 DIM Q0$=253,L$=40,A$=40,R$=40,X$=10,Y$=10,U$=10,X1$=10,N0$=10
65 DIM V$(40)=10,W%(40),O%(40),K%(40)
70 N0$="0000000000" : FOR N%=1% TO 40% : V$(N%)=N0$ : NEXT N%
80 OPEN "DR1:DEKL.DAT" ASFILE 1
100 REM BELOPPEN LÄSES, SEX RADER I VARJE BLOCK, MEN INTE RAD 23
110 FOR B%=0% TO 15% : Z=CALL(28666,1)+CALL(28668,B%)
120 FOR I%=0% TO 5% : IF I%=5% AND B%=4%*(B%/4%)+3% THEN 160
125 L$=MID$(Q0$,40%*I%+1%,40%) : A%=ASC(MID$(L$,2%,1%))
130 IF A%<48% OR A%>57% THEN 160
140 P%=INSTR(1%,L$,"<") : IF P%=0% THEN 160
150 N%=VAL(LEFT$(L$,2%)) : W%(N%)=B% : O%(N%)=40%*I%+P%+1%
155 A$=MID$(L$,P%+1%,9%) : GOSUB 500 : V$(N%)=Y$
160 NEXT I% : NEXT B%
200 REM REGLERNA, EN I TAGET OCH STEGEN FRÅN VÄNSTER
210 READ R$ : IF R$="/" THEN 400
220 P%=INSTR(1%,R$," ") : T%=VAL(LEFT$(R$,P%-1%)) : X$=N0$
230 IF P%>=LEN(R$) THEN 320
240 C$=MID$(R$,P%+1%,1%) : Q%=INSTR(P%+1%,R$+" "," ") : A$=""
250 IF Q%>P%+2% THEN A$=MID$(R$,P%+2%,Q%-P%-2%)
255 P%=Q% : Y$=N0$ : IF A$="" OR C$="%" THEN 270
260 IF LEFT$(A$,1%)<>"#" THEN Y$=V$(VAL(A$)) : GOTO 270
265 A$=RIGHT$(A$,2%) : GOSUB 500
270 IF C$="=" THEN X$=Y$
275 IF C$="+" THEN GOSUB 700
280 IF C$="-" THEN GOSUB 750 : GOSUB 700
285 IF C$="%" THEN C%=VAL(A$) : GOSUB 800
290 IF C$="P" THEN IF ASC(X$)>52% THEN X$=N0$
295 GOTO 230
320 V$(T%)=X$ : K%(T%)=1% : GOTO 210
400 REM SUMMORNA SKRIVS IN I DE BLOCK DÄR RUTORNA STÅR
410 FOR B%=0% TO 15% : F%=0%
420 FOR N%=1% TO 40% : IF K%(N%)=0% OR O%(N%)=0% OR W%(N%)<>B% THEN 460
430 IF F%=0% THEN Z=CALL(28666,1)+CALL(28668,B%) : F%=1%
440 GOSUB 600 : P%=O%(N%)
450 Q0$=LEFT$(Q0$,P%-1%)+A$+RIGHT$(Q0$,P%+9%)
460 NEXT N%
470 IF F%=1% THEN Z=CALL(28670,B%)
480 NEXT B%
490 CLOSE 1 : CHAIN "DR0:DEKL"
500 REM A$ SOM TIO ASCII-SIFFROR I Y$; MED MINUS TIOKOMPLEMENTET
510 Y$="" : G%=0% : FOR J%=1% TO LEN(A$) : A%=ASC(MID$(A$,J%,1%))
520 IF A%=45% THEN G%=1%
530 IF A%>47% AND A%<58% THEN Y$=Y$+CHR$(A%)
540 NEXT J% : Y$=RIGHT$(N0$+Y$,LEN(Y$)+1%)
550 IF G%=1% THEN GOSUB 750
560 RETURN
600 REM V$(N) SOM TEXT I A$, NIO TECKEN TILL HÖGER, MED BLANKT MELLAN
610 REM GRUPPERNA OM TRE SIFFROR
620 Y$=V$(N%) : G%=0% : IF ASC(Y$)>52% THEN G%=1% : GOSUB 750
630 E%=1%
640 IF E%<10% AND MID$(Y$,E%,1%)="0" THEN E%=E%+1% : GOTO 640
650 A$="" : FOR J%=0% TO 10%-E% : K1%=10%-J% : A$=MID$(Y$,K1%,1%)+A$
655 IF J%=2% OR J%=5% OR J%=8% THEN IF K1%>E% THEN A$=" "+A$
660 NEXT J% : IF G%=1% THEN A$="-"+A$
670 IF LEN(A$)>9% THEN A$="*********"
680 A$=RIGHT$(SPACE$(9%)+A$,LEN(A$)+1%) : RETURN
700 REM X$ = X$ + Y$, SIFFRA FÖR SIFFRA FRÅN HÖGER MED MINNESSIFFRA
710 U$="" : C1%=0% : FOR J%=0% TO 9% : K1%=10%-J%
720 D%=ASC(MID$(X$,K1%,1%))+ASC(MID$(Y$,K1%,1%))-96%+C1%
730 C1%=D%/10% : U$=CHR$(48%+D%-10%*C1%)+U$ : NEXT J%
740 X$=U$ : RETURN
750 REM Y$ = -Y$: NIORNAS KOMPLEMENT OCH SEDAN 1 TILL
760 U$="" : FOR J%=1% TO 10% : U$=U$+CHR$(105%-ASC(MID$(Y$,J%,1%))) : NEXT J%
770 X1$=X$ : X$=U$ : Y$="0000000001" : GOSUB 700 : Y$=X$ : X$=X1$ : RETURN
800 REM X$ = X$ * C% / 100, AVRUNDAT; MINUS GÖRS TILL PLUS FÖRST
810 G%=0% : IF ASC(X$)>52% THEN G%=1% : Y$=X$ : GOSUB 750 : X$=Y$
820 U$="" : C1%=0% : FOR J%=0% TO 9% : K1%=10%-J%
825 D%=(ASC(MID$(X$,K1%,1%))-48%)*C%+C1%
830 C1%=D%/10% : U$=CHR$(48%+D%-10%*C1%)+U$ : NEXT J%
840 X$=U$ : Y$="0000000050" : GOSUB 700 : X$="00"+LEFT$(X$,8%)
850 IF G%=1% THEN Y$=X$ : GOSUB 750 : X$=Y$
860 RETURN
900 DATA "6 =1 +2 +3 -4 -5","11 =7 +8 +9 -10","14 =6 +11"
910 DATA "15 =14 -12 -13 P","21 =16 +17 +18 +19 -20 P","22 =15"
920 DATA "23 =#6000","24 =22 -23 P","25 =24 %30"
930 DATA "26 =24 -#40000 P %25","27 =21 -#200000 P %1"
940 DATA "28 =25 +26 +27","30 =28 -29","/"
9999 END
