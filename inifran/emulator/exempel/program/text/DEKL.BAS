10 REM DEKL, SJÄLVDEKLARATIONEN 1982 SOM BLANKETT (UTANFÖR BOKEN)
20 REM SIDORNA ÄR SKÄRMBILDER I DR1:DEKL.DAT (SE DSKAPA) OCH BYTS MOT
30 REM SKIVAN MED CALL 28666, 28668 OCH 28670. FÄLTEN STÅR MELLAN < OCH >,
40 REM EN SIFFRA I KOLUMN 1 GÖR FÄLTET TILL EN RUTA FÖR ETT BELOPP, OCH
50 REM = FÖRE < ÄR EN RUTA SOM DKALK RÄKNAR. CTRL-K KÖR DKALK.
60 DIM Q0$=253,B$=253,L$=40,A$=40,R%(23),F%(20),G%(20),H%(20),T%(20)
70 FOR I%=0% TO 23% : READ R%(I%) : NEXT I%
80 OPEN "DR1:DEKL.DAT" ASFILE 1
90 Z=CALL(28666,1)+CALL(28668,16) : S%=ASC(Q0$)-48%
100 IF S%<1% OR S%>4% THEN S%=1%
110 GOSUB 600
200 REM TANGENTERNA, EN I TAGET
210 IF N%>0% THEN PRINT CUR(F%(K%),G%(K%)+C%);
220 GET K$ : A%=ASC(K$)
230 IF A%=13% THEN GOSUB 400 : GOSUB 430 : GOTO 210
240 IF A%=8% THEN IF C%>0% THEN C%=C%-1% : GOTO 210
250 IF A%=9% THEN IF C%<H%(K%)-1% THEN C%=C%+1% : GOTO 210
260 IF A%=14% THEN D%=1% : GOTO 500
270 IF A%=16% THEN D%=-1% : GOTO 500
280 IF A%=11% THEN 550
290 IF A%=24% THEN 9000
300 IF A%<32% OR N%=0% THEN 210
310 IF T%(K%)=1% THEN IF A%<>32% AND A%<>45% THEN IF A%<48% OR A%>57% THEN 210
320 PRINT K$; : Y%=1% : IF C%<H%(K%)-1% THEN C%=C%+1%
330 GOTO 210
400 REM EN RUTA STÄLLS TILL HÖGER NÄR MAN LÄMNAR DEN
410 IF N%=0% THEN RETURN
415 IF T%(K%)<>1% THEN RETURN
420 A%=R%(F%(K%))+G%(K%) : A$=""
422 FOR I%=A% TO A%+8% : B%=PEEK(I%) : IF B%<>32% THEN A$=A$+CHR$(B%)
424 NEXT I%
426 PRINT CUR(F%(K%),G%(K%));RIGHT$(SPACE$(9%)+A$,LEN(A$)+1%); : RETURN
430 REM NÄSTA FÄLT, MEN INTE DE SOM RÄKNAS
440 C%=0% : IF N%=0% THEN RETURN
450 K%=K%+1% : IF K%>=N% THEN K%=0%
460 IF T%(K%)=2% THEN 450
470 RETURN
500 REM CTRL-N OCH CTRL-P: NÄSTA OCH FÖRRA SIDAN
510 IF S%+D%<1% OR S%+D%>4% THEN 210
520 GOSUB 400 : GOSUB 700 : S%=S%+D% : GOSUB 600 : GOTO 210
550 REM CTRL-K: SPARA OCH RÄKNA
560 GOSUB 400 : GOSUB 700 : CLOSE 1
570 PRINT CUR(23,0);"Räknar ...";SPACE$(28%);
580 CHAIN "DR0:DKALK"
600 REM SIDAN S LÄSES FRÅN SKIVAN, OCH FÄLTEN LETAS UPP
610 PRINT CHR$(12); : N%=0% : K%=0% : C%=0% : Y%=0%
620 FOR B%=0% TO 3% : Z=CALL(28666,1)+CALL(28668,4%*S%-4%+B%)
630 FOR I%=6%*B% TO 6%*B%+5% : IF I%>22% THEN 680
640 L$=MID$(Q0$,40%*(I%-6%*B%)+1%,40%) : PRINT CUR(I%,0);L$;
650 P%=INSTR(1%,L$,"<") : IF P%=0% THEN 680
660 F%(N%)=I% : G%(N%)=P% : H%(N%)=INSTR(P%,L$,">")-P%-1% : T%(N%)=0%
665 A%=ASC(MID$(L$,2%,1%)) : IF A%>47% AND A%<58% THEN T%(N%)=1%
670 IF T%(N%)=1% THEN IF MID$(L$,P%-1%,1%)="=" THEN T%(N%)=2%
675 N%=N%+1%
680 NEXT I% : NEXT B%
690 GOSUB 800 : IF N%>0% THEN K%=N%-1% : GOSUB 430
695 RETURN
700 REM SIDAN S SPARAS FRÅN SKÄRMEN, OM DEN ÄR ÄNDRAD, OCH SIDNUMRET
710 IF Y%=0% THEN 760
720 PRINT CUR(23,0);"Sparar sidan";S%;SPACE$(24%);
730 FOR B%=0% TO 3% : B$="" : E%=6%*B%+5% : IF E%>22% THEN E%=22%
740 FOR I%=6%*B% TO E% : A%=R%(I%) : FOR J%=A% TO A%+39% : B$=B$+CHR$(PEEK(J%)) : NEXT J% : NEXT I%
745 IF E%=22% THEN B$=B$+SPACE$(40%)
750 Z=CALL(28666,1) : Q0$=B$ : Z=CALL(28670,4%*S%-4%+B%) : NEXT B%
760 Z=CALL(28666,1) : Q0$=CHR$(48%+S%) : Z=CALL(28670,16) : Y%=0% : RETURN
800 REM MEDDELANDERADEN
810 PRINT CUR(23,0);"RET:nästa  CTRL N/P:sida K:räkna X:slut"; : RETURN
900 DATA 31744,31872,32000,32128,32256,32384,32512,32640
910 DATA 31784,31912,32040,32168,32296,32424,32552,32680
920 DATA 31824,31952,32080,32208,32336,32464,32592,32720
9000 REM CTRL-X: SPARA OCH SLUTA
9010 GOSUB 400 : GOSUB 700 : CLOSE 1
9020 PRINT CHR$(12);"Deklarationen är sparad i DR1:DEKL.DAT."
9030 END
