10 REM FONSTER, TEXTFÖNSTER PÅ ABC80 (UTANFÖR BOKEN)
20 REM PROGRAMMET SKRIVER UT MED GOSUB 1000, OCH KODER I A$ VÄLJER
30 REM FÖNSTER SOM KODERNA TILL EN SKRIVARE: ESC O, ESC V OCH ESC S
40 DIM L$(79)=38,T$(7)=36,A$=80,D$=40,M$=38,Q$=38,F$=38,X$=40,Y$=38
50 DIM R%(7),K%(7),H%(7),B%(7),A%(7),P%(7),V%(7),Y%(7),Z%(7),U%(5)
60 E$=CHR$(27) : Z9%=0% : W%=-1% : S%=0% : Q%=0%
70 D$="  " : M$="" : Q$=""
80 FOR I%=1% TO 38% : D$=D$+" " : M$=M$+"-" : Q$=Q$+"=" : NEXT I%
90 PRINT CHR$(12);CUR(23,0);"TAB: byt  CTRL-X: stäng  CTRL-A: öppna";
100 REM TRE FÖNSTER, VART OCH ETT MED SIN TEXT
110 N%=0% : R1%=0% : K1%=0% : H1%=12% : B1%=26% : T1$="Anteckningar" : GOSUB 900
120 A$="Skriv här. TAB eller högerpilen byter fönster." : GOSUB 1000
130 A$=CHR$(13)+CHR$(13)+"CTRL-X stänger det, och CTRL-A öppnar ett igen." : GOSUB 1000
140 N%=1% : R1%=2% : K1%=20% : H1%=11% : B1%=20% : T1$="Koderna" : GOSUB 900
150 A$="CHR$(27) och sedan"+CHR$(13)+"O n r k h b titel" : GOSUB 1000
160 A$=CHR$(13)+" CR: öppnar n"+CHR$(13)+"V n: väljer n" : GOSUB 1000
170 A$=CHR$(13)+"S n: stänger n" : GOSUB 1000
180 A$=CHR$(13)+"FF rensar"+CHR$(13)+"(talen +32)" : GOSUB 1000
190 N%=2% : R1%=11% : K1%=8% : H1%=12% : B1%=24% : T1$="Inköp" : GOSUB 900
200 A$="mjölk"+CHR$(13)+"bröd"+CHR$(13)+"ost"+CHR$(13)+"äpplen" : GOSUB 1000
210 A$=E$+"V"+CHR$(32) : GOSUB 1000
300 REM TANGENTERNA, EN I TAGET
310 GOSUB 2900
320 GET K$ : C1%=ASC(K$)
330 IF C1%=9% THEN GOSUB 400 : GOTO 310
340 IF C1%=24% THEN GOSUB 450 : GOTO 310
350 IF C1%=1% THEN GOSUB 500 : GOTO 310
360 IF C1%<32% THEN IF C1%<>13% THEN IF C1%<>8% THEN 310
370 A$=K$ : GOSUB 1000 : GOTO 310
400 REM TAB: LYFT DET UNDERSTA FÖNSTRET
410 IF Z9%<2% THEN RETURN
420 A$=E$+"V"+CHR$(Z%(0%)+32%) : GOTO 1000
450 REM CTRL-X: STÄNG DET AKTIVA FÖNSTRET
460 IF W%<0% THEN RETURN
470 A$=E$+"S"+CHR$(W%+32%) : GOTO 1000
500 REM CTRL-A: ÖPPNA DET FÖRSTA STÄNGDA FÖNSTRET, DÄR DET VAR
510 N%=0%
520 IF A%(N%)=0% THEN 540
530 N%=N%+1% : IF N%<8% THEN 520 ELSE RETURN
540 IF H%(N%)=0% THEN R1%=N%*2% : K1%=N%*2%+4% : H1%=8% : B1%=18% : T1$="Fönster "+CHR$(48%+N%) : GOTO 900
550 R1%=R%(N%) : K1%=K%(N%) : H1%=H%(N%) : B1%=B%(N%) : T1$=T$(N%)
900 REM ÖPPNA FÖNSTER N% MED KODEN ESC O
910 A$=E$+"O"+CHR$(N%+32%)+CHR$(R1%+32%)+CHR$(K1%+32%)+CHR$(H1%+32%)
920 A$=A$+CHR$(B1%+32%)+T1$+CHR$(13)
1000 REM UT: SKRIV A$ GENOM TOLKEN; VANLIG TEXT EN BIT I TAGET
1010 I9%=1%
1020 IF I9%>LEN(A$) THEN RETURN
1030 C%=ASC(MID$(A$,I9%,1%)) : IF C%<32% OR S%<>0% OR W%<0% THEN GOSUB 1100 : I9%=I9%+1% : GOTO 1020
1040 GOSUB 2300 : GOTO 1020
1100 REM ETT TECKEN C%; TILLSTÅNDET S% SÄGER VAD DET ÄR
1110 ON S%+1% GOTO 1200,1300,1400,1500
1200 REM S%=0: STYRTECKEN TILL DET AKTIVA FÖNSTRET
1210 IF C%=27% THEN S%=1% : RETURN
1220 IF W%<0% THEN RETURN
1230 IF C%=13% THEN 2400
1240 IF C%=12% THEN 2500
1250 IF C%=8% THEN 2600
1260 RETURN
1300 REM S%=1: BOKSTAVEN EFTER ESC OCH HUR MÅNGA ARGUMENT DEN HAR
1310 N9%=0% : IF C%=79% THEN N9%=5%
1320 IF C%=86% OR C%=83% THEN N9%=1%
1330 S%=0% : IF N9%=0% THEN RETURN
1340 G%=C% : J%=0% : S%=2% : RETURN
1400 REM S%=2: ARGUMENTEN, TALET + 32
1410 U%(J%)=C%-32% : J%=J%+1% : IF J%<N9% THEN RETURN
1420 S%=0% : N%=U%(0%) : IF G%=86% THEN 2000
1430 IF G%=83% THEN 2100
1440 S%=3% : X$="" : RETURN
1500 REM S%=3: TITELN, TILL CR
1510 IF C%<>13% THEN IF LEN(X$)<36% THEN X$=X$+CHR$(C%)
1520 IF C%<>13% THEN RETURN
1530 S%=0% : GOTO 2200
2000 REM ESC V: VÄLJ FÖNSTER N% OCH LYFT DET ÖVERST
2010 IF N%<0% OR N%>7% THEN RETURN
2020 IF A%(N%)=0% THEN RETURN
2030 GOSUB 2700 : GOTO 2800
2100 REM ESC S: STÄNG FÖNSTER N%; DET UNDER RITAS OM I DESS RUTA
2110 IF N%<0% OR N%>7% THEN RETURN
2120 IF A%(N%)=0% THEN RETURN
2130 A%(N%)=0% : GOSUB 2700
2140 R5%=R%(N%) : R6%=R5%+H%(N%)-1% : K5%=K%(N%) : K6%=K5%+B%(N%)-1%
2150 FOR I8%=R5% TO R6% : PRINT CUR(I8%,K5%);LEFT$(D$,B%(N%)); : NEXT I8%
2160 W%=-1% : IF Z9%=0% THEN RETURN
2170 W%=Z%(Z9%-1%) : FOR I8%=0% TO Z9%-1% : N1%=Z%(I8%) : GOSUB 3000 : NEXT I8%
2180 N1%=W% : R5%=R%(W%) : R6%=R5% : K5%=0% : K6%=39% : GOTO 3000
2200 REM ESC O: ÖPPNA FÖNSTER N%, TOMT OCH ÖVERST
2210 IF N%<0% OR N%>7% THEN RETURN
2220 IF A%(N%)=1% THEN GOSUB 2100
2230 R%(N%)=U%(1%) : K%(N%)=U%(2%) : H%(N%)=U%(3%) : B%(N%)=U%(4%) : T$(N%)=X$
2240 IF H%(N%)<3% THEN H%(N%)=3%
2245 IF H%(N%)>23% THEN H%(N%)=23%
2250 IF B%(N%)<3% THEN B%(N%)=3%
2255 IF B%(N%)>40% THEN B%(N%)=40%
2260 IF R%(N%)<0% THEN R%(N%)=0%
2265 IF R%(N%)+H%(N%)>23% THEN R%(N%)=23%-H%(N%)
2270 IF K%(N%)<0% THEN K%(N%)=0%
2275 IF K%(N%)+B%(N%)>40% THEN K%(N%)=40%-B%(N%)
2280 IF V%(N%)<H%(N%)-2% THEN P%(N%)=Q% : V%(N%)=H%(N%)-2% : Q%=Q%+V%(N%)
2285 IF Q%>80% THEN Q%=Q%-V%(N%) : V%(N%)=0% : RETURN
2290 FOR I6%=P%(N%) TO P%(N%)+H%(N%)-3% : L$(I6%)="" : NEXT I6%
2295 Y%(N%)=0% : A%(N%)=1% : GOTO 2800
2300 REM TEXT FRÅN I9% TILL KANTEN ELLER NÄSTA STYRTECKEN
2310 I5%=P%(W%)+Y%(W%) : L%=LEN(L$(I5%)) : IF L%>=B%(W%)-2% THEN GOSUB 2400 : GOTO 2310
2320 J8%=I9% : N8%=I9%+B%(W%)-2%-L% : IF N8%>LEN(A$)+1% THEN N8%=LEN(A$)+1%
2330 J8%=J8%+1% : IF J8%<N8% THEN IF ASC(MID$(A$,J8%,1%))>=32% THEN 2330
2340 Y$=MID$(A$,I9%,J8%-I9%) : L$(I5%)=L$(I5%)+Y$
2350 PRINT CUR(R%(W%)+1%+Y%(W%),K%(W%)+1%+L%);Y$; : I9%=J8% : RETURN
2400 REM CR: NY RAD; NEDERST RULLAR FÖNSTRET
2410 Y%(W%)=Y%(W%)+1% : IF Y%(W%)<=H%(W%)-3% THEN RETURN
2420 Y%(W%)=H%(W%)-3% : IF H%(W%)=3% THEN 2440
2430 FOR I6%=P%(W%) TO P%(W%)+H%(W%)-4% : L$(I6%)=L$(I6%+1%) : NEXT I6%
2440 L$(P%(W%)+H%(W%)-3%)=""
2450 N1%=W% : R5%=R%(W%)+1% : R6%=R%(W%)+H%(W%)-2% : K5%=0% : K6%=39% : GOTO 3000
2500 REM FF: RENSA DET AKTIVA FÖNSTRET
2510 FOR I6%=P%(W%) TO P%(W%)+H%(W%)-3% : L$(I6%)="" : NEXT I6% : Y%(W%)=0%
2520 N1%=W% : R5%=R%(W%)+1% : R6%=R%(W%)+H%(W%)-2% : K5%=0% : K6%=39% : GOTO 3000
2600 REM BS: TA BORT DET SISTA TECKNET PÅ RADEN
2610 I5%=P%(W%)+Y%(W%) : L%=LEN(L$(I5%)) : IF L%=0% THEN RETURN
2620 L$(I5%)=LEFT$(L$(I5%),L%-1%) : PRINT CUR(R%(W%)+1%+Y%(W%),K%(W%)+L%);" "; : RETURN
2700 REM TA BORT N% UR ORDNINGEN Z% (UNDERST FÖRST)
2710 F%=0% : IF Z9%=0% THEN RETURN
2720 FOR I6%=0% TO Z9%-1%
2730 IF Z%(I6%)=N% THEN F%=1% ELSE Z%(I6%-F%)=Z%(I6%)
2740 NEXT I6% : Z9%=Z9%-F% : RETURN
2800 REM LÄGG N% ÖVERST: DET FÖRRA AKTIVA FÅR - I RAMEN, N% RITAS HELT
2810 O%=W% : Z%(Z9%)=N% : Z9%=Z9%+1% : W%=N%
2820 IF O%>=0% THEN N1%=O% : R5%=R%(O%) : R6%=R5% : K5%=0% : K6%=39% : GOSUB 3000
2830 N1%=N% : R5%=0% : R6%=22% : K5%=0% : K6%=39% : GOTO 3000
2900 REM MARKÖREN DÄR NÄSTA TECKEN SKRIVS
2910 IF W%<0% THEN PRINT CUR(23,38); : RETURN
2920 L%=LEN(L$(P%(W%)+Y%(W%))) : IF L%>B%(W%)-3% THEN L%=B%(W%)-3%
2930 PRINT CUR(R%(W%)+1%+Y%(W%),K%(W%)+1%+L%); : RETURN
3000 REM RITA FÖNSTER N1%, BARA RAD R5%-R6% OCH KOLUMN K5%-K6%
3010 R7%=R%(N1%) : IF R5%>R7% THEN R7%=R5%
3020 R8%=R%(N1%)+H%(N1%)-1% : IF R6%<R8% THEN R8%=R6%
3030 K7%=K%(N1%) : IF K5%>K7% THEN K7%=K5%
3040 K8%=K%(N1%)+B%(N1%)-1% : IF K6%<K8% THEN K8%=K6%
3050 IF R7%>R8% OR K7%>K8% THEN RETURN
3060 FOR I7%=R7% TO R8% : I4%=I7%-R%(N1%)
3070 IF I4%=0% THEN GOSUB 3200 : GOTO 3100
3080 IF I4%=H%(N1%)-1% THEN X$="+"+LEFT$(M$,B%(N1%)-2%)+"+" : GOTO 3100
3090 X$="!"+LEFT$(L$(P%(N1%)+I4%-1%)+D$,B%(N1%)-2%)+"!"
3100 PRINT CUR(I7%,K7%);MID$(X$,K7%-K%(N1%)+1%,K8%-K7%+1%);
3110 NEXT I7% : RETURN
3200 REM RAMENS ÖVERKANT MED TITELN; DET AKTIVA FÖNSTRET FÅR =
3210 F$=M$ : IF N1%=W% THEN F$=Q$
3220 X$="+"+LEFT$(LEFT$(F$,1%)+T$(N1%)+F$,B%(N1%)-2%)+"+" : RETURN
