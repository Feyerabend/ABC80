10 REM KURVOR MED SETDOT, ETT EXEMPEL TILL ABC80 INIFRÅN
20 REM SETDOT R,K: RAD 0-71 UPPIFRÅN, KOLUMN 2-79; KOLUMN 0-1 ÄR
25 REM RUTAN DÄR GRAFIKKODEN CHR$(151) STÅR
30 PRINT CHR$(12);
40 FOR R=0 TO 22 : PRINT CUR(R,0);CHR$(151); : NEXT R
50 FOR K=2 TO 79 : SETDOT 34,K : NEXT K
60 FOR R=0 TO 68 : SETDOT R,40 : NEXT R
70 FOR K=2 TO 79
80 SETDOT INT(34.5-30*SIN((K-40)/6)),K
90 SETDOT INT(34.5-30*COS((K-40)/4)*EXP(-ABS(K-40)/20)),K
100 NEXT K
110 PRINT CUR(23,0);"Sinus och en dämpad cosinus. Tangent!";
120 GET A$
130 PRINT CHR$(12);
140 END
