# Bara i 80-teckensläget (ed80.t80.out): ED på en rad längre än 40
# tecken, högerpilen till kolumn 45, CTRL-D två gånger och CTRL-P där,
# Q i luckan och resten av raden. Sedan CTRL-S 50 gånger på en tom rad,
# förbi kolumn 39, och en ny rad 30 där.
-k '10 PRINT "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz"\r20 END\rZ=CALL(16384,2)\r\w300\.ED 10\r\w300\.\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x04\x04\x10Q\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\x09\r\w300\.\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x13\x1330 REM\r\w300\.LIST\r\w300\.RUN\r\w300\.'
