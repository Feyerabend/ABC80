# DEL: ett intervall, en rad som inte finns och inget intervall; BYE går
# till BASIC med CLEAR (ABC80), och programmet går att köra.
-k '10 A=1\r20 A=2\r30 A=3\r40 PRINT A\r50 PRINT A+1\rZ=CALL(16384)\r\w300\.DEL 20-30\r\w300\.DEL 45\r\w300\.DEL\r\w300\.DEL 50-\r\w300\.LIST\r\w300\.BYE\r\w300\.LIST\r\w300\.RUN\r\w300\.'
