10 REM ORD: ordbehandlaren i Forth. Texten ligger på RAM-skivan.
15 PRINT CHR$(12);"ORD laddas. Det tar ungefär 25 sekunder."
17 DIM A$=40,F$=20,G$=40
20 Z=CALL(32768,2) : IF Z THEN PRINT "Fel på rad";Z : STOP
30 GOSUB 100 : A$="TNY ORD"
40 Z=CALL(32768,VAROOT(A$))
50 PRINT CHR$(12);"ORD": PRINT
60 PRINT "1 fortsätt   2 ny text   3 introduktionen   4 slut"
65 PRINT : PRINT "5 spara      6 läsa"
70 GET K$ : K=ASC(K$)-48 : IF K<1 OR K>6 THEN 70
80 IF K=4 THEN 9999
85 IF K>4 THEN GOSUB 300 : GOTO 50
90 IF K=3 THEN GOSUB 100
95 A$="ORD" : IF K=2 THEN A$="TNY ORD"
96 GOTO 40
100 PRINT CHR$(12);"ORD, en ordbehandlare i Forth" : PRINT
110 PRINT "Det du skriver hamnar i texten där markören står. Texten ligger"
120 PRINT "på RAM-skivan och får vara 27392 tecken. Raderna bryts vid"
130 PRINT "blanksteg, så du trycker bara RETURN när ett stycke slutar."
140 PRINT "Skärmen får 25 rader: 24 för texten, och den nedersta visar var"
150 PRINT "markören står, hur lång texten är och hur mycket som är fritt."
155 PRINT
160 PRINT "  CTRL-S ->  ett tecken bakåt, framåt (CTRL-D går också framåt)"
170 PRINT "  CTRL-E   en rad upp      CTRL-X   en rad ned"
180 PRINT "  CTRL-A   radens början   CTRL-F   radens slut"
190 PRINT "  CTRL-R   en sida upp     CTRL-V   en sida ned"
200 PRINT "  <-       ta bort tecknet före markören"
210 PRINT "  CTRL-G   ta bort tecknet efter markören"
220 PRINT "  CTRL-Q   till menyn: fortsätta, ny text, spara, läsa eller sluta"
225 PRINT
230 PRINT "Texten finns kvar tills du väljer ny text eller startar ORD igen."
240 PRINT "Spara den på skivan med 5 i menyn, och läs in den igen med 6." : PRINT
250 PRINT "Tryck på en tangent." : GET K$ : RETURN
300 REM Spara [5] och läsa [6]: namnet blir NAMN    EXT för SPARA och LADDA
310 PRINT : PRINT "Filens namn"; : IF F$<>"" THEN PRINT " (";F$;")";
320 INPUT ": ";G$ : IF G$="" THEN G$=F$
330 IF G$="" THEN RETURN
340 I=INSTR(1,G$,".") : IF LEN(G$)>12 THEN I=0 : GOTO 360
350 IF I=0 THEN G$=G$+".TXT" : GOTO 340
360 PRINT : IF I<2 OR I>9 OR LEN(G$)=I OR LEN(G$)>I+3 THEN Z=3 : GOTO 390
370 FOR J=1 TO LEN(G$) : C=ASC(MID$(G$,J,1)) : IF C<97 THEN 376
374 G$=LEFT$(G$,J-1)+CHR$(C-32)+MID$(G$,J+1,LEN(G$)-J)
376 NEXT J : F$=G$ : A$="SPARA " : IF K=6 THEN A$="LADDA "
380 A$=A$+LEFT$(G$,I-1)+SPACE$(9-I)+MID$(G$,I+1,LEN(G$)-I)+SPACE$(I+3-LEN(G$))
385 Z=CALL(32768,VAROOT(A$))
390 IF Z=0 AND K=5 THEN PRINT "Sparad: ";F$;
391 IF Z=0 AND K=6 THEN PRINT "Läst: ";F$;
392 IF ABS(Z)=1 THEN PRINT "FEL: texten fick inte plats";
394 IF Z=2 THEN PRINT "FEL: filen finns inte";
396 IF Z=3 THEN PRINT "FEL: filnamnet";
398 IF Z>255 THEN PRINT "FEL: skivan, fel";Z-256;
399 PRINT : PRINT : PRINT "Tryck på en tangent." : GET K$ : RETURN
