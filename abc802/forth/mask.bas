10 REM Masken: SNAKE1 (prov/) i Forth i REM-raderna och i maskinkod.
20 Z=CALL(32768,2) : IF Z THEN PRINT "Fel på rad";Z : STOP
30 POKE 42980,14,255,195,30,96,77,65,83,75,77,75,32,32,65,66,83
40 Z=CALL(42980,42985)
50 PRINT CHR$(12);"Masken, som SNAKE1. Tangenterna a z s w."
60 PRINT : PRINT "1 Forth   2 maskinkod   3 tidsprov   4 slut"
70 GET K$ : K=ASC(K$)-48 : IF K<1 OR K>4 THEN 70
80 IF K=3 THEN 300
90 IF K=4 THEN STOP
100 INPUT "Väntan per steg i 1/94 s ";V
110 GOSUB 800 : ON K GOSUB 500,600 : GOSUB 850 : ON K GOSUB 550,650
120 PRINT CUR(10,30);CHR$(135);"G A M E   O V E R";CHR$(151);
130 PRINT CUR(12,26);CHR$(135);"Poäng";Z;N;"steg på";T;"s";CHR$(151);
140 GET K$ : GOTO 50
300 REM Tidsprov: inga tangenter och ingen väntan, tills masken krockar
310 V=0 : GOSUB 800 : GOSUB 500 : GOSUB 850 : GOSUB 550 : T1=T : N1=N
320 GOSUB 800 : GOSUB 600 : GOSUB 850 : GOSUB 650
330 PRINT CHR$(12);"Från start till krock, utan tangenter:"
340 PRINT "Forth:    ";N1;"steg på";T1;"s"
350 PRINT "Maskinkod:";N;"steg på";T;"s"
360 GOTO 60
500 A$=NUM$(V)+" MASK" : Z=CALL(32768,VAROOT(A$)) : RETURN
550 A$="N @" : N=CALL(32768,VAROOT(A$)) : RETURN
600 Z=CALL(43008,V) : RETURN
650 N=PEEK(43011)+256*PEEK(43012) : RETURN
800 POKE 65521,1 : POKE 65523,0 : POKE 65524,0 : POKE 65525,0 : RETURN
850 T=PEEK(65523)*60+PEEK(65524)+PEEK(65525)/93.75
860 T=INT(T*100)/100 : RETURN
1000 REM FORTH ( Masken som SNAKE1: rad 0-71, kolumn 2-158 som SET DOT )
1010 REM FORTH VARIABLE T  VARIABLE P  VARIABLE CU  VARIABLE X  VARIABLE Y
1020 REM FORTH VARIABLE FX  VARIABLE FY  VARIABLE R1  VARIABLE C1
1030 REM FORTH VARIABLE V  VARIABLE N
1040 REM FORTH CREATE RA 501 ALLOT  CREATE CA 501 ALLOT
1050 REM FORTH : SD ( r c -- )  2 - SWAP PLOT ;
1060 REM FORTH : CD ( r c -- )  2 - SWAP UNPLOT ;
1070 REM FORTH : D? ( r c -- f )  2 - SWAP POINT? ;
1080 REM FORTH : RAM  GR  159 2 DO 0 I SD 71 I SD LOOP
1090 REM FORTH   72 0 DO I 2 SD I 158 SD LOOP ;
1100 REM FORTH : MAT  61 RND 5 + FX !  138 RND 10 + FY ! ;
1110 REM FORTH : START  0 RANDOMIZE RAM
1120 REM FORTH   5 0 DO 5 I - RA I + C!  79 CA I + C! LOOP
1130 REM FORTH   5 T !  0 P !  0 N !  1 CU !  1 R1 !  79 C1 !  MAT ;
1140 REM FORTH ( Tangenten k: t ger riktningen ny, utom när den är ej )
1150 REM FORTH : TA ( k t ny ej -- k )  CU @ = IF 2DROP EXIT THEN
1160 REM FORTH   >R OVER = IF R> CU ! ELSE R> DROP THEN ;
1170 REM FORTH : TANGENT  INKEY  97 1 3 TA  115 3 1 TA
1180 REM FORTH   122 2 4 TA  119 4 2 TA  DROP ;
1190 REM FORTH : STEG  RA C@ X !  CA C@ Y !  CU @
1200 REM FORTH   DUP 1 = IF -1 Y +! THEN  DUP 2 = IF 1 X +! THEN
1210 REM FORTH   DUP 3 = IF 1 Y +! THEN  4 = IF -1 X +! THEN ;
1220 REM FORTH : MAT? ( -- f )  X @ FX @ =  Y @ FY @ =  AND ;
1230 REM FORTH : ATA  X @ RA T @ + C!  Y @ CA T @ + C!
1240 REM FORTH   T @ 500 < IF 1 T +! THEN  1 P +!  MAT ;
1250 REM FORTH : SKIFT  T @ 1- DUP RA + C@ SWAP CA + C@  T @
1260 REM FORTH   BEGIN DUP WHILE  DUP RA + DUP 1- C@ SWAP C!
1270 REM FORTH   DUP CA + DUP 1- C@ SWAP C!  1- REPEAT DROP  CA C! RA C! ;
1280 REM FORTH : RITA  R1 @ C1 @ CD  T @ 0 DO RA I + C@ CA I + C@ SD LOOP
1290 REM FORTH   T @ 1- DUP RA + C@ R1 !  CA + C@ C1 !  FX @ FY @ SD ;
1300 REM FORTH : VANTA  V @ BEGIN DUP WHILE  65525 C@
1310 REM FORTH   BEGIN DUP 65525 C@ = 0= UNTIL DROP 1- REPEAT DROP ;
1320 REM FORTH : MASK ( v -- poäng )  V !  START
1330 REM FORTH   BEGIN TANGENT STEG  MAT? IF ATA 0 ELSE X @ Y @ D? THEN
1340 REM FORTH   0= WHILE  X @ RA T @ 1- + C!  Y @ CA T @ 1- + C!
1350 REM FORTH   SKIFT RITA  1 N +!  VANTA  REPEAT  P @ ;
