10 REM Forth i BASIC: orden står i REM-raderna från rad 1000.
20 Z=CALL(32768,2) : IF Z THEN PRINT "Fel på rad";Z : STOP
25 DIM A%(10),B%(10),E%(3),F%(3) : E%(0)=1 : F%(1)=1 : E%(2)=-1 : F%(3)=-1
30 A$="HILBERT" : GOSUB 900 : GOSUB 2100 : GOSUB 870
40 A$="DRAKE" : GOSUB 900 : GOSUB 2150 : GOSUB 870
50 A$="LIV" : GOSUB 900
60 PRINT CHR$(12);"Forth: Z=CALL(32768,1)   Orden: LIST 1000-"
70 END
800 POKE 65521,1 : POKE 65523,0 : POKE 65524,0 : POKE 65525,0 : RETURN
850 T=PEEK(65523)*60+PEEK(65524)+PEEK(65525)/93.75
860 T=INT(T*10)/10 : RETURN
870 PRINT CUR(23,0);CHR$(135);"BASIC: ";A$;R%;"på";T;"s,";
880 PRINT INT(T/T1*10)/10;"gånger Forth. Tryck";
890 GET K$ : RETURN
900 REM Kör A$ i Forth och visa svaret och tiden.
910 GOSUB 800 : Z=CALL(32768,VAROOT(A$)) : GOSUB 850 : T1=T
940 PRINT CUR(23,0);CHR$(135);"Forth: ";A$;Z;"på";T;"s. Tryck en tangent";
950 GET K$
960 RETURN
1000 REM FORTH ( Sköldpaddan: X Y, riktning D 0-3 medurs, S punkter per steg )
1010 REM FORTH VARIABLE X  VARIABLE Y  VARIABLE D  VARIABLE S  VARIABLE R
1020 REM FORTH CREATE DX 1 , 0 , -1 , 0 ,  CREATE DY 0 , 1 , 0 , -1 ,
1030 REM FORTH : VRID ( n -- )  D @ + 3 AND D ! ;
1040 REM FORTH : STEG  S @ 0 DO D @ 2* DUP DX + @ X +! DY + @ Y +!
1050 REM FORTH   X @ Y @ PLOT LOOP  1 R +! ;
1060 REM FORTH : START ( x y s -- ) S ! Y ! X ! 0 D ! 0 R ! GR X @ Y @ PLOT ;
1100 REM FORTH ( Hilbertkurvan: n nivåer, a = 1 höger eller -1 vänster )
1110 REM FORTH : HIL ( n a -- )  OVER IF
1120 REM FORTH   DUP VRID  OVER 1- OVER NEGATE RECURSE  STEG
1130 REM FORTH   DUP NEGATE VRID  OVER 1- OVER RECURSE  STEG
1140 REM FORTH   OVER 1- OVER RECURSE  DUP NEGATE VRID  STEG
1150 REM FORTH   OVER 1- OVER NEGATE RECURSE  VRID DROP
1160 REM FORTH   ELSE DROP DROP THEN ;
1170 REM FORTH : HILBERT  48 3 2 START  5 1 HIL  R @ ;
1200 REM FORTH ( Draken: pappret viks n gånger, s = 1 eller -1 )
1210 REM FORTH : DRA ( n s -- )  OVER 0= IF DROP DROP STEG EXIT THEN
1220 REM FORTH   OVER 1- 1 RECURSE  DUP VRID  OVER 1- -1 RECURSE  DROP DROP ;
1230 REM FORTH : DRAKE  52 44 2 START  3 D !  10 1 DRA  R @ ;
1300 REM FORTH ( Livet: 48 x 33 rutor med kant, C cellerna, N grannarna )
1310 REM FORTH 50 CONSTANT B  CREATE C 1750 ALLOT  CREATE N 1750 ALLOT
1320 REM FORTH ' PLOT CONSTANT TAND  ' UNPLOT CONSTANT SLACK
1330 REM FORTH : 4P ( x y xt -- )  >R 2DUP R@ EXECUTE 2DUP 1+ R@ EXECUTE
1340 REM FORTH   SWAP 1+ SWAP 2DUP R@ EXECUTE 1+ R> EXECUTE ;
1350 REM FORTH : RUTA ( k r f -- )  IF TAND ELSE SLACK THEN
1360 REM FORTH   >R 2* SWAP 2* 31 + SWAP R> 4P ;
1370 REM FORTH : +1 ( a -- )  DUP C@ 1+ SWAP C! ;
1380 REM FORTH : GRANNAR ( a -- )  DUP 51 - +1 DUP 50 - +1 DUP 49 - +1
1390 REM FORTH   DUP 1- +1 DUP 1+ +1 DUP 49 + +1 DUP 50 + +1 51 + +1 ;
1400 REM FORTH : NOLL ( a -- )  0 OVER C! DUP 1+ 1749 CMOVE ;
1410 REM FORTH : RAKNA N NOLL 1700 51 DO C I + C@ IF N I + GRANNAR THEN LOOP ;
1420 REM FORTH : NY ( i -- 0|1 )  DUP N + C@ SWAP C + C@
1430 REM FORTH   IF 2 - 2 U< ELSE 3 = THEN NEGATE ;
1440 REM FORTH : GEN  RAKNA  33 0 DO 48 0 DO  J 1+ B * I 1+ + DUP NY
1450 REM FORTH   2DUP SWAP C + C@ = IF 2DROP ELSE
1460 REM FORTH   DUP ROT C + C!  I J ROT RUTA THEN  LOOP LOOP ;
1470 REM FORTH : SA  0 RANDOMIZE GR C NOLL  33 0 DO 48 0 DO  3 RND 0= IF
1480 REM FORTH   1 J 1+ B * I 1+ + C + C!  I J 1 RUTA THEN  LOOP LOOP ;
1490 REM FORTH : LIV  SA 0 BEGIN GEN 1+ INKEY OVER 500 = OR UNTIL ;
2000 REM Samma kurvor i BASIC: X% Y%, riktning D%, R% steg, L% nivån.
2010 REM GOSUB är rekursivt, men variablerna är gemensamma: A%() och B%()
2020 REM har a och s för varje nivå, som Forth har dem på stacken.
2030 R%=0 : D%=0 : PRINT CHR$(12); : FOR I%=0 TO 23
2040 PRINT CUR(I%,0);CHR$(151); : NEXT I% : SET DOT Y%,X%+2 : RETURN
2100 X%=48 : Y%=3 : GOSUB 2030 : L%=5 : A%(5)=1
2110 GOSUB 800 : GOSUB 2200 : GOSUB 850 : RETURN
2150 X%=52 : Y%=44 : GOSUB 2030 : D%=3 : L%=10 : B%(10)=1
2160 GOSUB 800 : GOSUB 2300 : GOSUB 850 : RETURN
2200 IF L%=0 THEN RETURN
2210 T%=A%(L%) : GOSUB 2600 : A%(L%-1)=-A%(L%) : GOSUB 2250 : GOSUB 2500
2220 T%=-A%(L%) : GOSUB 2600 : A%(L%-1)=A%(L%) : GOSUB 2250 : GOSUB 2500
2230 A%(L%-1)=A%(L%) : GOSUB 2250 : T%=-A%(L%) : GOSUB 2600 : GOSUB 2500
2240 A%(L%-1)=-A%(L%) : GOSUB 2250 : T%=A%(L%) : GOSUB 2600 : RETURN
2250 L%=L%-1 : GOSUB 2200 : L%=L%+1 : RETURN
2300 IF L%=0 THEN GOSUB 2500 : RETURN
2310 B%(L%-1)=1 : GOSUB 2350 : T%=B%(L%) : GOSUB 2600
2320 B%(L%-1)=-1 : GOSUB 2350 : RETURN
2350 L%=L%-1 : GOSUB 2300 : L%=L%+1 : RETURN
2500 FOR I%=1 TO 2 : X%=X%+E%(D%) : Y%=Y%+F%(D%) : SET DOT Y%,X%+2
2510 NEXT I% : R%=R%+1 : RETURN
2600 D%=D%+T% : IF D%<0 THEN D%=3
2610 IF D%>3 THEN D%=0
2620 RETURN
