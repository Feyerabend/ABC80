PROGRAM REKURSION(OUTPUT);
(* Funktioner, rekursion, FORWARD och Hanois torn. *)
VAR DRAG : INTEGER;

FUNCTION FAK(N : INTEGER) : INTEGER;
BEGIN
  IF N <= 1 THEN FAK := 1 ELSE FAK := N * FAK(N - 1)
END;

FUNCTION SGD(A, B : INTEGER) : INTEGER;
BEGIN
  IF B = 0 THEN SGD := A ELSE SGD := SGD(B, A MOD B)
END;

FUNCTION UDDA(N : INTEGER) : BOOLEAN; FORWARD;

FUNCTION JAMN(N : INTEGER) : BOOLEAN;
BEGIN
  IF N = 0 THEN JAMN := TRUE ELSE JAMN := UDDA(N - 1)
END;

FUNCTION UDDA;
BEGIN
  IF N = 0 THEN UDDA := FALSE ELSE UDDA := JAMN(N - 1)
END;

PROCEDURE FLYTTA(N, FRAN, TILL, OVER : INTEGER);
BEGIN
  IF N > 0 THEN
  BEGIN
    FLYTTA(N - 1, FRAN, OVER, TILL);
    DRAG := DRAG + 1;
    IF N = 4 THEN WRITE(FRAN:1, '-', TILL:1, ' ');
    FLYTTA(N - 1, OVER, TILL, FRAN)
  END
END;

BEGIN
  WRITELN(FAK(7), FAK(1):3);
  WRITELN(SGD(1071, 462):1, ' ', SGD(-12, 18):1);
  WRITELN(JAMN(10), ' ', UDDA(10), ' ', ODD(7):6);
  DRAG := 0;
  FLYTTA(6, 1, 3, 2);
  WRITELN(DRAG:1, ' drag')
END.
